// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  fr
  en
}

enum AnimalSex {
  male
  female
  unknown
}

enum AnimalStatus {
  available
  reserved
  sold
  on_hold
  not_for_sale
}

enum MediaType {
  photo
  video
}

enum ProductCategory {
  terrarium
  substrate
  decor
  // Added 2026-07 to match the client's real Clover catalog (bulbs, heat
  // mats/lamps — "Lumiere" in Clover) — previously had nowhere to go.
  lighting
  // Spare parts, sealants, filters, charcoal etc. ("Piece Remplacement/
  // Electronique" in Clover) — also had no home before.
  equipment
  food_live
  food_frozen
  food_packaged
  // Vitamins, care/cleaning products ("Supplement" in Clover).
  supplement
}

enum OrderStatus {
  paid
  preparing
  ready_for_pickup
  picked_up
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum FinancialRecordType {
  sale
  refund
  cancellation_fee
}

enum AdminRole {
  owner
  staff
}

enum ExperienceLevel {
  beginner
  intermediate
  advanced
}

enum AuditAction {
  create
  update
  delete
}

enum FinancialChannel {
  online
  in_store
  // Sale rung up directly on the standalone Clover device (store counter or
  // an expo booth) and mirrored into the platform after the fact. Distinct
  // from `in_store`, which is a legacy sale recorded by an admin through the
  // in-app POS (see PosSale) — that flow is no longer how in-person sales
  // actually happen, but old records keep their original channel.
  clover_pos
}

enum PosPaymentMethod {
  cash
  card
}

enum PosSaleStatus {
  completed
  failed
}

enum CampaignStatus {
  draft
  sent
}

enum CloverImportCandidateStatus {
  pending
  created
  ignored
}

enum CloverCategoryRuleAction {
  auto_product
  ignore
}

// Animal browse taxonomy for the public site (nav bubbles, filters). Values
// match the `NavCategories` i18n keys 1:1 so no extra mapping is needed.
// Two-level in spirit (reptiles_*/amphibians_*) but stored flat, same as
// ProductCategory.
enum AnimalCategory {
  reptiles_snakes
  reptiles_lizards
  reptiles_turtles
  reptiles_other
  amphibians_frogs
  amphibians_salamanders
  amphibians_other
}

model Species {
  id               String           @id @default(uuid())
  commonNameFr     String
  commonNameEn     String
  scientificName   String
  category         AnimalCategory   @default(reptiles_other)
  careSheetUrl     String?
  experienceLevel  ExperienceLevel?
  descriptionFr    String?
  descriptionEn    String?
  adultSizeFr      String?
  adultSizeEn      String?
  lifespanFr       String?
  lifespanEn       String?
  temperamentFr    String?
  temperamentEn    String?
  dietFr           String?
  dietEn           String?
  humidity         String?
  tempDay          String?
  tempNight        String?
  uvbNeeds         String?
  enclosureMinSize String?
  substrate        String?
  feedingFrequency String?
  handlingFr       String?
  handlingEn       String?
  animals          Animal[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Animal {
  id            String         @id @default(uuid())
  species       Species        @relation(fields: [speciesId], references: [id])
  speciesId     String
  morph         String
  sex           AnimalSex      @default(unknown)
  birthDate     DateTime?
  weightGrams   Float?
  priceCAD      Decimal
  status        AnimalStatus   @default(available)
  descriptionFr String
  descriptionEn String
  dam           Animal?        @relation("Parentage_Dam", fields: [damId], references: [id])
  damId         String?
  sire          Animal?        @relation("Parentage_Sire", fields: [sireId], references: [id])
  sireId        String?
  damOffspring  Animal[]       @relation("Parentage_Dam")
  sireOffspring Animal[]       @relation("Parentage_Sire")
  media         Media[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  posSaleItems  PosSaleItem[]
  // Links this record to its counterpart Clover inventory item. Set the
  // first time it's synced from Clover (new item created there) or the
  // first time it's pushed to Clover (new animal created on the site).
  // Null means it has never been reconciled with Clover — still fine for
  // display, but it won't get real-time stock updates either direction.
  cloverItemId    String?          @unique
  cloverSaleItems CloverSaleItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Media {
  id        String    @id @default(uuid())
  animal    Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId  String
  type      MediaType
  url       String
  sortOrder Int       @default(0)
}

model Product {
  id                String          @id @default(uuid())
  sku               String          @unique
  category          ProductCategory
  nameFr            String
  nameEn            String
  descriptionFr     String?
  descriptionEn     String?
  imageUrl          String?
  priceCAD          Decimal
  stockQty          Int             @default(0)
  published         Boolean         @default(false)
  requiresColdChain Boolean         @default(false)
  weightKg          Float?
  bundleItems       BundleItem[]
  orderItems        OrderItem[]
  wishlistItems     WishlistItem[]
  posSaleItems      PosSaleItem[]
  cloverItemId      String?         @unique
  cloverSaleItems   CloverSaleItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Bundle {
  id             String       @id @default(uuid())
  nameFr         String
  nameEn         String
  bundlePriceCAD Decimal
  active         Boolean      @default(true)
  items          BundleItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model BundleItem {
  id        String  @id @default(uuid())
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  bundleId  String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int     @default(1)
}

model Customer {
  id            String         @id @default(uuid())
  fullName      String
  email         String         @unique
  phone         String?
  preferredLang Locale         @default(fr)
  ageVerified   Boolean        @default(false)
  internalNotes String?
  passwordHash  String?
  emailOptOut   Boolean        @default(false)
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// A customer can wish-list either an Animal or a Product, never both.
model WishlistItem {
  id         String   @id @default(uuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  animal     Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId   String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String?
  createdAt  DateTime @default(now())

  @@unique([customerId, animalId])
  @@unique([customerId, productId])
}

model Address {
  id         String   @id @default(uuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  street     String
  city       String
  province   String
  postalCode String
  country    String   @default("CA")
  orders     Order[]
}

model Order {
  id                        String            @id @default(uuid())
  customer                  Customer          @relation(fields: [customerId], references: [id])
  customerId                String
  status                    OrderStatus       @default(paid)
  shippingAddress           Address           @relation(fields: [shippingAddressId], references: [id])
  shippingAddressId         String
  // Tax breakdown snapshotted at checkout time (rates may change later, but
  // receipts must keep reflecting what was actually charged). Null on orders
  // placed before tax support existed.
  subtotalCAD               Decimal?
  gstAmountCAD              Decimal?
  qstAmountCAD              Decimal?
  totalCAD                  Decimal?
  healthGuaranteeAcceptedAt DateTime?
  preparingAt               DateTime?
  readyForPickupAt          DateTime?
  pickupDeadlineAt          DateTime?
  pickedUpAt                DateTime?
  cancelledAt               DateTime?
  cancellationFeeCAD        Decimal?
  refundAmountCAD           Decimal?
  items                     OrderItem[]
  payments                  Payment[]
  financialRecords          FinancialRecord[]
  review                    Review?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
}

model OrderItem {
  id             String   @id @default(uuid())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  animal         Animal?  @relation(fields: [animalId], references: [id])
  animalId       String?
  product        Product? @relation(fields: [productId], references: [id])
  productId      String?
  quantity       Int      @default(1)
  priceAtSaleCAD Decimal
}

model Payment {
  id          String        @id @default(uuid())
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  amountCAD   Decimal
  provider    String
  providerRef String?
  status      PaymentStatus @default(pending)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
}

model AdminUser {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  role           AdminRole       @default(staff)
  auditLogs      AuditLog[]
  announcements  Announcement[]
  posSales       PosSale[]
  emailCampaigns EmailCampaign[]
  createdAt      DateTime        @default(now())
}

model AuditLog {
  id          String      @id @default(uuid())
  adminUser   AdminUser   @relation(fields: [adminUserId], references: [id])
  adminUserId String
  entity      String
  entityId    String
  action      AuditAction
  createdAt   DateTime    @default(now())
}

model Announcement {
  id               String    @id @default(uuid())
  messageFr        String
  messageEn        String
  startsAt         DateTime  @default(now())
  endsAt           DateTime?
  active           Boolean   @default(true)
  createdBy        AdminUser @relation(fields: [createdByAdminId], references: [id])
  createdByAdminId String
  createdAt        DateTime  @default(now())
}

// Revenue/refund ledger, covering both online orders and in-store POS sales.
// Online sale entries are booked once an order is marked ready for pickup
// (the point staff confirm the items are set aside and the sale is final);
// refund/fee entries are booked on cancellation. In-store entries are booked
// immediately when a POS sale is recorded.
model FinancialRecord {
  id            String              @id @default(uuid())
  order         Order?              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String?
  posSale       PosSale?            @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  posSaleId     String?
  cloverSale    CloverSale?         @relation(fields: [cloverSaleId], references: [id], onDelete: Cascade)
  cloverSaleId  String?
  type          FinancialRecordType
  channel       FinancialChannel    @default(online)
  paymentMethod PosPaymentMethod?
  amountCAD     Decimal
  // Populated on "sale" records so the finance ledger can show the tax
  // breakdown, not just the tax-inclusive amountCAD total.
  gstAmountCAD  Decimal?
  qstAmountCAD  Decimal?
  note          String?
  createdAt     DateTime            @default(now())
}

// A sale registered in person by an admin through this in-app POS, as
// opposed to being rung up directly on the standalone Clover device (see
// CloverSale) or placed online (Order). This used to be the only in-person
// sales path; now that staff ring up in-person sales straight on the Clover
// device (store counter and expo booths alike), this flow is kept only as a
// manual/backup path — real in-person sales arrive as CloverSale records.
model PosSale {
  id                  String            @id @default(uuid())
  paymentMethod       PosPaymentMethod
  status              PosSaleStatus     @default(completed)
  // amountCAD is the tax-inclusive grand total (what's charged/collected);
  // the breakdown below is what the printed/emailed receipt itemizes.
  subtotalCAD         Decimal?
  gstAmountCAD        Decimal?
  qstAmountCAD        Decimal?
  amountCAD           Decimal
  cloverTransactionId String?
  // Optional — only needed if staff want to email a receipt to the customer.
  customerName        String?
  customerEmail       String?
  items               PosSaleItem[]
  financialRecords    FinancialRecord[]
  createdByAdminId    String
  createdByAdmin      AdminUser         @relation(fields: [createdByAdminId], references: [id])
  createdAt           DateTime          @default(now())
}

model PosSaleItem {
  id             String   @id @default(uuid())
  posSale        PosSale  @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  posSaleId      String
  animal         Animal?  @relation(fields: [animalId], references: [id])
  animalId       String?
  product        Product? @relation(fields: [productId], references: [id])
  productId      String?
  quantity       Int      @default(1)
  priceAtSaleCAD Decimal
}

model Review {
  id         String   @id @default(uuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  rating     Int
  comment    String
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Singleton row (id is always "singleton") holding admin-editable store policy.
model StoreSettings {
  id                         String   @id @default("singleton")
  pickupDeadlineBusinessDays Int      @default(4)
  cancellationFeePercent     Decimal  @default(15)
  adminNotificationEmail     String?
  // Canadian federal (TPS/GST) and Quebec provincial (TVQ/QST) tax
  // registration numbers and rates, applied to every online order and
  // in-store sale and itemized on every receipt.
  gstNumber                  String?
  qstNumber                  String?
  gstRatePercent             Decimal  @default(5)
  qstRatePercent             Decimal  @default(9.975)
  // Public-facing store info shown to customers (footer, receipts,
  // transactional emails) — editable from the admin, bilingual where the
  // content itself is language-specific (address/hours).
  contactEmail               String   @default("contact@reptileconcept.ca")
  contactPhone               String   @default("(514) 555-0199")
  addressFr                  String   @default("Lachine, QC — sur rendez-vous")
  addressEn                  String   @default("Lachine, QC — by appointment")
  hoursFr                    String   @default("Lun–Sam 10h–18h")
  hoursEn                    String   @default("Mon–Sat 10am–6pm")
  updatedAt                  DateTime @updatedAt
}

// One row per bilingual message the team sends to the customer list.
model EmailCampaign {
  id               String         @id @default(uuid())
  subjectFr        String
  subjectEn        String
  bodyFr           String
  bodyEn           String
  status           CampaignStatus @default(draft)
  recipientCount   Int?
  sentAt           DateTime?
  createdByAdminId String
  createdByAdmin   AdminUser      @relation(fields: [createdByAdminId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// Mirror of a sale that happened directly on the standalone Clover device
// (store counter or an expo booth) — never created by an admin action, only
// ever written by the Clover webhook handler or the polling fallback
// (src/lib/clover-sync.ts). The site is read-only with respect to these:
// Clover is the authority on when/whether the sale happened, this table just
// reflects it so inventory and the finance dashboard stay accurate.
model CloverSale {
  id                String            @id @default(uuid())
  cloverOrderId     String            @unique
  cloverPaymentId   String?
  amountCAD         Decimal
  paymentMethod     PosPaymentMethod?
  items             CloverSaleItem[]
  financialRecords  FinancialRecord[]
  cloverCreatedAt   DateTime?
  syncedAt          DateTime          @default(now())
}

model CloverSaleItem {
  id             String     @id @default(uuid())
  cloverSale     CloverSale @relation(fields: [cloverSaleId], references: [id], onDelete: Cascade)
  cloverSaleId   String
  animal         Animal?    @relation(fields: [animalId], references: [id])
  animalId       String?
  product        Product?   @relation(fields: [productId], references: [id])
  productId      String?
  quantity       Int        @default(1)
  priceAtSaleCAD Decimal
}

// Dedupe log for inbound Clover webhook events — Clover can and does deliver
// the same event more than once, and inventory/order processing must not
// double-decrement stock on a replay.
model CloverWebhookEvent {
  id          String   @id // `${objectId}:${ts}` as reported by Clover
  objectId    String
  type        String
  processedAt DateTime @default(now())
}

// A Clover inventory item captured on the Clover device (store or expo) that
// doesn't correspond to any Animal/Product on the site yet — surfaced in the
// admin as a queue so staff can turn it into a real listing (with photos,
// genetics, bilingual copy) with one click, instead of hunting down the
// Clover item id by hand. Populated by the webhook/poller; never touched by
// an admin action except to flip its status.
model CloverImportCandidate {
  id                 String                       @id @default(uuid())
  cloverItemId       String                       @unique
  name               String
  priceCAD           Decimal
  cloverCategoryName String?
  stockCount         Int?
  status             CloverImportCandidateStatus  @default(pending)
  firstSeenAt        DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
}

// A one-time-set rule per Clover category name, applied automatically to
// every future item captured under that category — so accessories keep
// flowing onto the site without a human re-deciding "what site category is
// this" every time new stock gets rung into Clover. Deliberately never
// consulted for anything that should stay a manual "Créer un animal" review
// (see processCloverItem in src/lib/clover-sync.ts) — staff opt a category
// into this only when it's genuinely generic merchandise.
model CloverCategoryRule {
  id                 String                   @id @default(uuid())
  // Empty string stands in for "no Clover category set" (Clover items can
  // be categoryless) — kept as "" rather than null so the unique
  // constraint behaves predictably across databases.
  cloverCategoryName String                   @unique
  action             CloverCategoryRuleAction
  // Required when action = auto_product; unused for action = ignore.
  productCategory    ProductCategory?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
}

// Singleton row (id is always "singleton") tracking the polling fallback
// cursor, plus the last webhook verification code Clover sent while setting
// up the webhook URL in the Developer Dashboard (surfaced in the admin so
// whoever configures it doesn't have to dig through logs).
model CloverSyncState {
  id                    String    @id @default("singleton")
  lastPolledAt          DateTime?
  lastVerificationCode  String?
  updatedAt             DateTime  @updatedAt
}

// Lightweight, self-hosted page view log — avoids paying for a third-party
// analytics subscription. One row per page load; aggregated on the admin
// performance dashboard, never displayed raw.
model PageView {
  id        String   @id @default(uuid())
  path      String
  locale    Locale
  createdAt DateTime @default(now())

  @@index([createdAt])
}
