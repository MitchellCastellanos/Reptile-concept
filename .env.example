# Postgres connection string (Neon, Vercel Postgres, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Unpooled/direct Postgres URL — use for prisma migrate deploy on Neon/Vercel.
# On Neon: same as DATABASE_URL but WITHOUT "-pooler" in the hostname.
# Vercel Neon integration often exposes this as POSTGRES_URL_NON_POOLING.
# DIRECT_URL="postgresql://user:password@ep-xxx.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Random secret used to sign the admin session cookie (and review links).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

# Optional — transactional emails are logged to the console until this is set.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Reptiles Concept <ventes@reptiles-concept.ca>"

# Optional — public site URL used in email links (admin order link, review link).
# Defaults to VERCEL_URL in production, http://localhost:3000 otherwise.
# NEXT_PUBLIC_SITE_URL="https://reptiles-concept.ca"

# Optional — protects GET /api/cron/expire-orders and /api/cron/clover-sync
# if they're reachable publicly. Same secret covers both routes.
# CRON_SECRET="change-me-too"

# Public storefront gate — visitors see /coming-soon until staff unlocks.
# Set SITE_GATE_ENABLED=false (or remove it) when the site is ready to launch.
# SITE_GATE_ENABLED="true"
# STAFF_GATE_PASSWORD="changeme123"

# Clover integration — the standalone Clover device (store counter + expo
# booth) is where in-person sales actually happen now; the site mirrors them.
# Without these set, chargeCloverTerminal() simulates a payment and the
# Clover sync routes (webhook + polling cron) have nothing to talk to.
#
# Private API Token from the Clover Developer Dashboard (needs Inventory +
# Orders + Payments + Webhooks scopes — the merchant ID is in the same
# dashboard).
# CLOVER_MERCHANT_ID="XXXXXXXXXXXXX"
# CLOVER_API_TOKEN="..."
#
# Set to "sandbox" while testing against a Clover sandbox merchant; omit (or
# set to "production") once pointed at the real merchant account.
# CLOVER_ENV="sandbox"
#
# Random secret appended to the webhook URL registered in the Clover
# Developer Dashboard (https://.../api/clover/webhook?secret=THIS_VALUE), so
# the endpoint isn't wide open. Generate one the same way as SESSION_SECRET.
# CLOVER_WEBHOOK_SECRET="change-me-too"

# Stripe — online checkout (card + Klarna). Without STRIPE_SECRET_KEY the
# checkout falls back to the dev "manual" placeholder (order marked paid
# immediately, no real charge). See docs/STRIPE-SETUP.md for the full go-live
# checklist once the merchant account exists.
#
# Secret key from Stripe Dashboard → Developers → API keys (sk_test_… or sk_live_…).
# STRIPE_SECRET_KEY="sk_test_..."
#
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks, after
# registering POST https://YOUR_DOMAIN/api/stripe/webhook (events listed in
# docs/STRIPE-SETUP.md). Use the Stripe CLI secret while testing locally.
# STRIPE_WEBHOOK_SECRET="whsec_..."
